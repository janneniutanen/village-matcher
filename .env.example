# Village Matcher — local configuration
# Copy this file to .env and fill in your values.

# Password you type to open the tool in the browser
MATCHER_PASSWORD=

# Google Sheet ID (the long string in the sheet URL)
SPREADSHEET_ID=

# Exact name of the tab containing applicant form responses
SOURCE_TAB=Form Responses 1

# Digitransit API key — from portal.digitransit.fi
DIGITRANSIT_API_KEY=

# OpenRouteService token — from openrouteservice.org
ORS_API_KEY=

# Filename of the service account key file (.json) inside this folder
# Your developer will send you this file securely.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=village-matcher-key.json
